---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ExcerptCard from "../../components/ExcerptCard.astro";
import TagFilter from "../../components/TagFilter.astro";
import { getExcerpts, tagCounts } from "../../lib/content";

const excerpts = await getExcerpts();
const tags = [...tagCounts(excerpts).entries()];
---

<BaseLayout title="摘录 · 个人网页" active="excerpts" path="LIBRARY / EXCERPTS">
  <div class="overview-page">
    <header class="overview-head">
      <p class="overview-kicker">EXCERPTS / {String(excerpts.length).padStart(2, "0")}</p>
      <h1 class="overview-title">摘录</h1>
      <p class="overview-desc">随性摘抄。按标签筛选。</p>
      <TagFilter tags={tags} total={excerpts.length} />
    </header>

    <div class="overview-list" data-search-section>
      <div class="excerpt-grid">
        {excerpts.map((entry) => <ExcerptCard entry={entry} />)}
      </div>
    </div>
  </div>
</BaseLayout>
