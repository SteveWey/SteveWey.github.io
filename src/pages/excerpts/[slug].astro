---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getExcerpts, formatDate, getEntrySlug } from "../../lib/content";
import { withBase } from "../../lib/url";

export async function getStaticPaths() {
  const excerpts = await getExcerpts();
  return excerpts.map((entry) => ({
    params: { slug: getEntrySlug(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const excerpts = await getExcerpts();
const index = excerpts.findIndex((item) => getEntrySlug(item) === getEntrySlug(entry));
const prev = index > 0 ? excerpts[index - 1] : undefined;
const next = index >= 0 && index < excerpts.length - 1 ? excerpts[index + 1] : undefined;
const { title, text, source, sourceTitle, tags, status, date, updated } = entry.data;
const { Content } = await render(entry);
const hasBody = Boolean(entry.body?.trim());
const sourceMatch = source.match(/^\[([^\]]+)\]\((https?:\/\/[^)]+)\)$/);
---

<BaseLayout
  title={`${title} · 摘录 · 个人博客`}
  description={text || source}
  active="excerpts"
  path="LIBRARY / EXCERPTS"
  backHref="/excerpts/"
  backLabel="返回摘录"
>
  <article class="note-page excerpt-detail">
    <header class="note-head">
      <nav class="note-breadcrumb" aria-label="面包屑">
        <a href={withBase("/")}>首页</a>
        <span class="sep">/</span>
        <a href={withBase("/excerpts/")}>摘录</a>
        <span class="sep">/</span>
        <span>{tags[0] || "摘抄"}</span>
      </nav>
      <p class="note-meta">
        <span>{tags[0] || "摘录"}</span>
        <span class="dot" aria-hidden="true"></span>
        <span>{status}</span>
        <span class="dot" aria-hidden="true"></span>
        <time datetime={date.toISOString()}>{formatDate(updated ?? date, "full")}</time>
      </p>
      <h1 class="note-page-title">{title}</h1>
      <div class="note-tag-row">
        {tags.map((tag) => (
          <a href={withBase(`/excerpts/?tag=${encodeURIComponent(tag)}`)}>#{tag}</a>
        ))}
      </div>
    </header>

    <div class="excerpt-detail-body">
      {hasBody ? (
        <div class="prose excerpt-prose">
          <Content />
        </div>
      ) : text ? (
        <blockquote class="excerpt-quote">{text}</blockquote>
      ) : (
        <p class="empty-state">这条摘录还没有正文。</p>
      )}

      <dl class="excerpt-source-list">
        <div><dt>出处</dt><dd>{sourceMatch ? <a href={sourceMatch[2]} target="_blank" rel="noreferrer">{sourceMatch[1]}</a> : source}</dd></div>
        {sourceTitle && <div><dt>篇目</dt><dd>{sourceTitle}</dd></div>}
        <div><dt>状态</dt><dd>{status}</dd></div>
        <div><dt>日期</dt><dd>{formatDate(updated ?? date, "full")}</dd></div>
      </dl>

      <div class="excerpt-detail-actions">
        <a class="note-back" href={withBase("/excerpts/")}>← 回到摘录列表</a>
      </div>
    </div>

    {(prev || next) && (
      <nav class="post-nav" aria-label="相邻摘录">
        {prev ? (
          <a href={withBase(`/excerpts/${getEntrySlug(prev)}/`)}>
            <small>← PREVIOUS</small>
            <strong>{prev.data.title}</strong>
          </a>
        ) : <span />}
        {next ? (
          <a href={withBase(`/excerpts/${getEntrySlug(next)}/`)}>
            <small>NEXT →</small>
            <strong>{next.data.title}</strong>
          </a>
        ) : <span />}
      </nav>
    )}
  </article>
</BaseLayout>
