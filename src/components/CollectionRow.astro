---
import type { CollectionEntryType } from "../lib/content";

interface Props {
  entry: CollectionEntryType;
}
const { entry } = Astro.props;
const { title, type, platform, url, people, tags, status } = entry.data;
---

<div
  class="collection-item"
  id={entry.id}
  data-search={`${title} ${type} ${platform} ${people.join(" ")} ${tags.join(" ")}`}
  data-tags={tags.join(",")}
  data-kind="collection"
>
  <span class="collection-icon" aria-hidden="true">▶</span>
  <div class="collection-main">
    <div class="collection-meta">
      <span>{type}</span>
      <span>·</span>
      <span>{platform}</span>
      {status && <span>·</span>}
      {status && <span>{status}</span>}
    </div>
    {url ? (
      <a class="collection-title" href={url} target="_blank" rel="noreferrer">{title}</a>
    ) : (
      <span class="collection-title">{title}</span>
    )}
  </div>
  <span class="collection-extra">{people.length ? people.join(" & ") : type}</span>
</div>
