---
import type { NoteEntry } from "../lib/content";
import { formatDate, getEntrySlug } from "../lib/content";
import { withBase } from "../lib/url";

interface Props {
  entry: NoteEntry;
}
const { entry } = Astro.props;
const { title, description, tags, date, updated } = entry.data;
---

<a
  class="study-card"
  href={withBase(`/notes/${getEntrySlug(entry)}/`)}
  data-search={`${title} ${description} ${tags.join(" ")}`}
  data-tags={tags.join(",")}
  data-kind="study"
>
  <span class="study-label">{tags[0] || "STUDY"}</span>
  <h3 class="study-title">{title}</h3>
  <p class="study-desc">{description}</p>
  <div class="study-foot">
    <span>{formatDate(updated ?? date, "full")}</span>
    <span>笔记</span>
  </div>
</a>
