---
import type { ExcerptEntry } from "../lib/content";
import { formatDate } from "../lib/content";
import { withBase } from "../lib/url";

interface Props {
  entry: ExcerptEntry;
}
const { entry } = Astro.props;
const { title, text, source, tags, status, date } = entry.data;

const body = entry.body ?? "";
const plainBody = body
  .replace(/```[\s\S]*?```/g, " ")
  .replace(/!\[[^\]]*\]\([^)]*\)/g, " ")
  .replace(/\[([^\]]*)\]\([^)]*\)/g, "$1")
  .replace(/^#{1,6}\s+/gm, "")
  .replace(/[*_>`~]/g, " ")
  .replace(/\s+/g, " ")
  .trim();

const placeholder = /^(先记|原文较长|一条待验证|正文待|原文待)/.test((text ?? "").trim());
const preview = !placeholder && text ? text : plainBody.slice(0, 220);
const truncated = !text && plainBody.length > 220;
---

<a
  class="excerpt-card"
  href={withBase(`/excerpts/${entry.id}/`)}
  id={entry.id}
  data-search={`${title} ${preview} ${source} ${tags.join(" ")}`}
  data-tags={tags.join(",")}
  data-kind="excerpt"
>
  <div class="excerpt-top">
    <span class="excerpt-kind">{tags[0] || "摘抄"}</span>
    <span class:list={["excerpt-status", { "excerpt-status--pending": status === "待校对" || status === "待补全" }]}>
      {status}
    </span>
  </div>
  <h3 class="excerpt-title">{title}</h3>
  {preview && <p class="excerpt-text">{preview}{truncated ? "…" : ""}</p>}
  <div class="excerpt-foot">
    <span class="excerpt-source">{source}</span>
    <time class="excerpt-date" datetime={date.toISOString()}>{formatDate(date)}</time>
  </div>
</a>

