---
import type { MusicEntry } from "../lib/content";
import { withBase } from "../lib/url";

interface Props {
  tracks: MusicEntry[];
  minimal?: boolean;
  showList?: boolean;
}
const { tracks, minimal = false, showList = true } = Astro.props;
const first = tracks[0];
const firstCover = first.data.cover ? withBase(first.data.cover) : "";
---

{tracks.length === 0 ? (
  <div class="empty-state">暂无音乐。</div>
) : (
  <>
    {!minimal && (
      <>
        <div class="music-panel" data-music-player>
          <div
            class="music-art"
            aria-hidden="true"
            style={firstCover ? `background-image: url("${firstCover}")` : undefined}
          ></div>
          <div class="music-info">
            <p class="music-eyebrow">NOW PLAYING / TRACK 01</p>
            <h3 class="music-title" id="music-title">{first.data.title}</h3>
            <p class="music-artist" id="music-artist">{first.data.artist}</p>
            <div class="music-controls">
              <button class="music-toggle" type="button" data-music-toggle aria-label="播放">
                <span class="music-icon" aria-hidden="true">▶</span>
              </button>
              <div class="music-bar" aria-hidden="true">
                <span class="music-fill" id="music-fill"></span>
              </div>
              <span class="music-time">
                <span id="music-current">0:00</span> / <span id="music-duration">{first.data.duration}</span>
              </span>
            </div>
          </div>
        </div>

        {showList && (
          <div class="track-list" aria-label="音乐列表">
            {tracks.map((track, index) => {
              const cover = track.data.cover ? withBase(track.data.cover) : "";
              return (
                <button
                  class:list={["track-row", { "is-active": index === 0 }]}
                  type="button"
                  data-track
                  data-src={withBase(track.data.audio)}
                  data-title={track.data.title}
                  data-artist={track.data.artist}
                  data-duration={track.data.duration}
                  data-cover={cover}
                  data-lyrics={track.data.lyrics ? withBase(track.data.lyrics) : ""}
                  data-search={`${track.data.title} ${track.data.artist} ${track.data.tags.join(" ")}`}
                  data-tags={track.data.tags.join(",")}
                  data-kind="music"
                >
                  <span class="track-index">{String(index + 1).padStart(2, "0")}</span>
                  <span class="track-main">
                    <strong>{track.data.title}</strong>
                    <small>{track.data.artist}</small>
                  </span>
                  <span class="track-duration">{track.data.duration}</span>
                  <span class="track-state" aria-hidden="true">▶</span>
                </button>
              );
            })}
          </div>
        )}
      </>
    )}

    <div
      class="music-lyrics"
      data-lyrics
      data-lyrics-src={first.data.lyrics ? withBase(first.data.lyrics) : ""}
      hidden
    >
      <p class="lyric-line lyric-prev" data-lyric-prev></p>
      <p class="lyric-line lyric-current" data-lyric-current></p>
      <p class="lyric-line lyric-next" data-lyric-next></p>
    </div>

    <audio id="music-audio" preload="metadata" src={withBase(first.data.audio)}></audio>

    <button class="mini-player" id="mini-player" type="button" data-music-toggle aria-label="播放" hidden>
      <span
        class="mini-player-cover"
        aria-hidden="true"
        style={firstCover ? `background-image: url("${firstCover}")` : undefined}
      ></span>
      <span class="mini-player-control" aria-hidden="true">
        <span class="music-icon">▶</span>
      </span>
    </button>
  </>
)}

<script>
  import "../scripts/music";
</script>
