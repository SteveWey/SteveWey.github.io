---
import type { NoteEntry } from "../lib/content";
import { formatDate } from "../lib/content";
import { withBase } from "../lib/url";

interface Props {
  entry: NoteEntry;
}
const { entry } = Astro.props;
const { title, description, kind, tags, date, updated } = entry.data;
---

<a
  class="note-row"
  href={withBase(`/notes/${entry.id}/`)}
  data-search={`${title} ${description} ${tags.join(" ")}`}
  data-tags={tags.join(",")}
  data-kind={kind}
>
  <span class:list={["note-kind", { "note-kind--tech": kind === "tech" }]}>
    {kind === "tech" ? "技术" : "学习"}
  </span>
  <div class="note-main">
    <h3 class="note-title">{title}</h3>
    <p class="note-desc">{description}</p>
    <div class="note-tags">
      {tags.map((tag) => <span>#{tag}</span>)}
    </div>
  </div>
  <time class="note-date" datetime={(updated ?? date).toISOString()}>{formatDate(updated ?? date, "full")}</time>
  <span class="note-arrow" aria-hidden="true">↗</span>
</a>
